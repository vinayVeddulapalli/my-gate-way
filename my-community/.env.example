# ==========================================
# MyCommunity Environment Variables (Local Dev)
# ==========================================

# Backend Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3002

# PostgreSQL Database (Local via Docker or native install)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/my_community_db?schema=public"

# Redis Cache & Background Jobs (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Authentication
JWT_SECRET=super_secret_local_dev_jwt_key_do_not_use_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Push Notifications (Zero-cost local mock mode)
# When set to true, notification events are logged locally without requiring paid SMS or third-party API keys
ENABLE_MOCK_NOTIFICATIONS=true
