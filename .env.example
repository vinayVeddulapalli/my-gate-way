# Gateway Security - Environment Variables Configuration

# Supabase Credentials (optional for local demo mode; required for live Supabase sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side ONLY (Never expose in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME="Gateway Security"
NEXT_PUBLIC_DEFAULT_COMMUNITY_ID="a0000000-0000-0000-0000-000000000001"
